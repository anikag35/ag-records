---
/**
 * The back of the sleeve: the origin story, where it was made, what was
 * playing, and how to get in touch.
 */
import { linerNotes } from "../data/catalogue";
---

<section class="section" id="liner-notes">
  <div class="shell">
    <div class="section-head">
      <h2 class="heading">Liner notes</h2>
      <p class="marque">Credits and thanks</p>
    </div>

    <div class="grid">
      <div class="col">
        <h3 class="sub marque">{linerNotes.firstSingle.title}</h3>
        <p class="prose body">{linerNotes.firstSingle.body}</p>
      </div>

      <div class="col">
        <h3 class="sub marque">Recorded at</h3>
        <ul class="plain">
          {linerNotes.recordedAt.map((place) => <li>{place}</li>)}
        </ul>

        <h3 class="sub marque spaced">On rotation</h3>
        <ul class="plain">
          {
            linerNotes.playlists.map((p) => (
              <li>
                <a href={p.href} rel="noopener">
                  {p.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="col">
        <h3 class="sub marque">Get in touch</h3>
        <ul class="plain contact">
          {
            linerNotes.contact.map((c) => (
              <li>
                <a href={c.href} rel="noopener">
                  {c.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 0.8fr);
    gap: clamp(1.75rem, 5vw, 4rem);
    align-items: start;
  }

  .sub {
    margin: 0 0 0.9rem;
    color: var(--text-soft);
  }

  .spaced {
    margin-top: 2rem;
  }

  .body {
    margin: 0;
    font-size: 0.9375rem;
  }

  .plain {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
    font-size: 0.9375rem;
    color: var(--text-soft);
  }

  .plain a {
    text-decoration: none;
    border-bottom: 1px solid var(--hairline);
    padding-bottom: 0.1rem;
  }

  .plain a:hover {
    border-bottom-color: var(--text);
  }

  .contact a {
    color: var(--text);
    border-bottom-color: var(--text-dim);
  }

  @media (max-width: 56rem) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
