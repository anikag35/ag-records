---
import { releases, label, waveformFor } from "../data/catalogue";
import { withBase } from "../lib/paths";

const LEAD = 0.6;
const SEG = 0.75;

const catalogOf = (n: number) => `AG-${String(n).padStart(3, "0")}`;

const bands = releases.map((release) => ({
  title: release.title,
  catalog: catalogOf(release.n),
  seed: release.repo,
  bars: waveformFor(release.repo)?.bars ?? [],
}));

const length = 1 + LEAD + releases.length * SEG;
---

<section
  class="tt"
  data-turntable
  data-bands={JSON.stringify(bands)}
  data-lead={LEAD}
  data-seg={SEG}
  style={`--tt-length:${length}`}
  hidden
>
  <div class="stage">
    <div class="deck">
      <canvas
        role="img"
        aria-label={`Turntable. A record with ${releases.length} bands, one per release. Use the track buttons to move the needle.`}
      ></canvas>
    </div>

    <div class="side">
      <div class="tabs" role="tablist" aria-label="Side A">
        <button
          role="tab"
          id="tt-tab-sleeve"
          aria-controls="tt-panel-sleeve"
          aria-selected="true"
          aria-label="Sleeve"
        >
          Sleeve
        </button>
        {
          releases.map((release) => (
            <button
              role="tab"
              id={`tt-tab-${release.n}`}
              aria-controls={`tt-panel-${release.n}`}
              aria-selected="false"
              aria-label={`A${release.n}, ${release.title}`}
              tabindex="-1"
            >
              A{release.n}
            </button>
          ))
        }
      </div>

      <div class="panels">
        <article
          class="panel"
          role="tabpanel"
          id="tt-panel-sleeve"
          aria-labelledby="tt-tab-sleeve"
        >
          <p class="marque">{label.name}</p>
          <h1 class="name">{label.artist}</h1>
          <p class="credit">{label.tagline}</p>
          <p class="lead">{label.standfirst}</p>
          <p class="marque hint">
            <span class="wide-only">Scroll to drop the needle</span>
            <span class="narrow-only">Tap a band to drop the needle</span>
          </p>
        </article>

        {
          releases.map((release) => {
            const wave = waveformFor(release.repo);
            return (
              <article
                class="panel"
                role="tabpanel"
                id={`tt-panel-${release.n}`}
                aria-labelledby={`tt-tab-${release.n}`}
                hidden
              >
                <p class="marque meta">
                  <span class="cat">{catalogOf(release.n)}</span>
                  {release.tag && <span>{release.tag}</span>}
                </p>
                <h2 class="title">{release.title}</h2>
                <p class="marque facts">
                  <span>{release.stack.join(" · ")}</span>
                  <span>{release.when}</span>
                  {wave && (
                    <span>
                      {wave.commits} commits, {wave.days}{" "}
                      {wave.days === 1 ? "day" : "days"}
                    </span>
                  )}
                </p>
                <p class="lead">{release.blurb}</p>
                <div class="notes">
                  {release.notes.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </div>
                {release.clip && (
                  <video
                    class="clip"
                    src={withBase(release.clip)}
                    poster={release.poster ? withBase(release.poster) : undefined}
                    controls
                    muted
                    loop
                    playsinline
                    preload="none"
                  />
                )}
                <ul class="links">
                  {release.links.map((link) => (
                    <li>
                      <a href={link.href} rel="noopener">
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </article>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { mount } from "../lib/turntable";

  const root = document.querySelector<HTMLElement>("[data-turntable]");
  const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (root && !still) {
    document.documentElement.dataset.turntable = "on";
    root.hidden = false;
    mount(root);
  }
</script>

<style>
  .tt {
    height: calc(100svh * var(--tt-length));
  }

  .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    overflow: hidden;
  }

  .deck {
    position: relative;
    min-width: 0;
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .side {
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(1.25rem, 3vh, 2rem);
    padding: calc(1.5rem + env(safe-area-inset-top, 0px)) var(--gutter) 1.5rem
      clamp(1.5rem, 3vw, 2.75rem);
    overflow: hidden auto;
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .tabs button {
    appearance: none;
    background: none;
    border: 1px solid var(--line);
    border-radius: 2px;
    color: var(--silver-dim);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.45rem 0.7rem;
    min-height: 2.25rem;
    cursor: pointer;
    transition:
      color 140ms var(--ease),
      border-color 140ms var(--ease),
      background-color 140ms var(--ease);
  }

  .tabs button:hover {
    color: var(--foil);
    border-color: var(--silver-dim);
  }

  .tabs button[aria-selected="true"] {
    color: var(--ink);
    background: var(--foil);
    border-color: var(--foil);
  }

  .panel {
    max-width: 34rem;
    animation: drop 240ms var(--ease);
  }

  @keyframes drop {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
  }

  :where(.panel > *) {
    margin: 0;
  }

  .name,
  .title {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    text-transform: var(--display-transform);
    letter-spacing: var(--display-tracking);
    line-height: var(--display-leading);
  }

  .name {
    margin-top: 0.75rem;
    font-size: calc(clamp(3rem, 6.2vw, 5.75rem) * var(--display-scale));
  }

  .title {
    margin-top: 0.6rem;
    font-size: calc(clamp(2.5rem, 5vw, 4.5rem) * var(--display-scale));
  }

  .credit {
    margin-top: 0.9rem;
    color: var(--silver);
    font-size: 1.0625rem;
    font-weight: 500;
  }

  .meta,
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
  }

  .cat {
    color: var(--foil);
  }

  .facts {
    margin-top: 0.9rem;
  }

  .lead {
    margin-top: 1.25rem;
    color: var(--foil);
    line-height: 1.6;
  }

  .notes {
    margin-top: 1rem;
    color: var(--silver);
    font-size: 0.8125rem;
    line-height: 1.65;
  }

  .notes p {
    margin: 0;
  }

  .notes p + p {
    margin-top: 0.75em;
  }

  .clip {
    margin-top: 1.25rem;
    width: 100%;
    max-height: 30vh;
    border: 1px solid var(--line);
    background: #08090a;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 1.25rem;
    padding: 0;
    list-style: none;
    font-size: 0.8rem;
  }

  .links a {
    color: var(--foil);
    text-decoration: none;
    border-bottom: 1px solid var(--silver-dim);
    padding-bottom: 0.1rem;
  }

  .links a:hover {
    border-bottom-color: var(--foil);
  }

  .hint {
    margin-top: 1.75rem;
  }

  .narrow-only {
    display: none;
  }

  @media (max-width: 56rem) {
    .tt {
      height: auto;
    }

    .stage {
      position: static;
      height: auto;
      display: block;
      overflow: visible;
    }

    .deck {
      height: 52svh;
      min-height: 18rem;
    }

    .side {
      padding: 1.25rem var(--gutter) 3rem;
      overflow: visible;
      justify-content: flex-start;
    }

    .wide-only {
      display: none;
    }

    .narrow-only {
      display: inline;
    }
  }
</style>
