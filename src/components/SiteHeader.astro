---
import { contact, label } from "../data/catalogue";
---

<header class="site-header">
  <p class="who">{label.artist}</p>
  <nav aria-label="Contact">
    <ul>
      {
        contact.map((link) => (
          <li>
            <a
              href={link.href}
              rel={link.href.startsWith("http") ? "noopener me" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
    height: calc(var(--header-h) + env(safe-area-inset-top, 0px));
    padding: env(safe-area-inset-top, 0px) clamp(0.9rem, 2vw, 1.75rem) 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: var(--ground);
    font-family: var(--font-caps);
    font-size: clamp(0.66rem, 0.85vw, 0.78rem);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text);
  }

  .who {
    margin: 0;
    white-space: nowrap;
  }

  ul {
    display: flex;
    gap: clamp(1rem, 2.4vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-block;
    padding-block: 0.6rem;
    color: var(--text);
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0 calc(100% - 0.45rem) / 0 1.5px no-repeat;
    transition: background-size 220ms var(--ease);
  }

  a:hover,
  a:focus-visible {
    background-size: 100% 1.5px;
  }

  @media (max-width: 26rem) {
    .who {
      display: none;
    }

    .site-header {
      justify-content: center;
    }
  }
</style>
