---
import "@fontsource-variable/bodoni-moda/standard.css";
import "@fontsource-variable/anybody/standard.css";
import "@fontsource/courier-prime/400.css";
import "@fontsource/courier-prime/700.css";
import Base from "../../layouts/Base.astro";
import Sleeve from "../../components/Sleeve.astro";
import Track from "../../components/Track.astro";
import { releases } from "../../data/catalogue";

const variants = {
  a: {
    name: "A",
    pairing: "Big Shoulders Display + IBM Plex Mono",
    style: "",
  },
  b: {
    name: "B",
    pairing: "Bodoni Moda + IBM Plex Mono",
    style:
      '--font-display:"Bodoni Moda Variable", serif; --display-weight:500; --display-transform:none; --display-tracking:-0.015em; --display-leading:0.95; --display-scale:0.92;',
  },
  c: {
    name: "C",
    pairing: "Anybody Extra Wide + Courier Prime",
    style:
      '--font-display:"Anybody Variable", sans-serif; --font-mono:"Courier Prime", monospace; --display-weight:800; --display-stretch:150%; --display-transform:uppercase; --display-tracking:0; --display-leading:0.95; --display-scale:0.56; --body-size:1rem;',
  },
};

export function getStaticPaths() {
  return ["a", "b", "c"].map((variant) => ({ params: { variant } }));
}

const key = Astro.params.variant as keyof typeof variants;
const variant = variants[key];
---

<Base title={`Compare ${variant.name}`} rootStyle={variant.style}>
  <p class="bar">
    <strong>{variant.name}</strong>
    <span>{variant.pairing}</span>
  </p>

  <Sleeve />

  <section class="section">
    <div class="shell">
      <div class="section-head">
        <h2 class="heading">Releases</h2>
        <p class="marque">5 tracks · press a row for the notes</p>
      </div>
      <Track release={releases[0]} />
    </div>
  </section>
</Base>

<style>
  .bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
    margin: 0;
    padding: 0.6rem var(--gutter);
    display: flex;
    gap: 1rem;
    align-items: baseline;
    background: var(--foil);
    color: var(--ink);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
